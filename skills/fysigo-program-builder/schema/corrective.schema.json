{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "corrective"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "duration_weeks": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "principle_md": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "duration_weeks",
        "principle_md"
      ],
      "additionalProperties": false
    },
    "from_coach": {
      "type": "object",
      "properties": {
        "problem_md": {
          "type": "string",
          "minLength": 1
        },
        "why_gym_alone_md": {
          "type": "string",
          "minLength": 1
        },
        "what_correctives_do_md": {
          "type": "string",
          "minLength": 1
        },
        "why_this_approach_md": {
          "type": "string",
          "minLength": 1
        },
        "what_to_expect_md": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "name",
            "date"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "problem_md",
        "why_gym_alone_md",
        "what_correctives_do_md",
        "why_this_approach_md",
        "what_to_expect_md",
        "signature"
      ],
      "additionalProperties": false
    },
    "volume_targets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$"
          },
          "category_label": {
            "type": "string",
            "minLength": 1
          },
          "description_md": {
            "type": "string"
          },
          "weekly_targets": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9-]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "target_count": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "unit": {
                  "default": "sessions",
                  "type": "string",
                  "enum": [
                    "sessions",
                    "sets",
                    "minutes",
                    "reps"
                  ]
                },
                "duration_per": {
                  "type": "string"
                },
                "instructions_md": {
                  "type": "string",
                  "minLength": 1
                },
                "why_md": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "daily",
                      "weekly",
                      "priority",
                      "unilateral",
                      "gym"
                    ]
                  }
                },
                "video_url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "target_count",
                "unit",
                "instructions_md"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "category",
          "category_label",
          "weekly_targets"
        ],
        "additionalProperties": false
      }
    },
    "inject_into_strength": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "target_program_slug": {
          "type": "string"
        },
        "injections": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "type": "object",
                "properties": {
                  "workout_type": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "workout_type"
                ],
                "additionalProperties": false
              },
              "exercises": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sets": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "reps": {
                      "type": "string"
                    },
                    "cues_md": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "match",
              "exercises"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "enabled",
        "injections"
      ],
      "additionalProperties": false
    },
    "missing_piece_md": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "metadata",
    "from_coach",
    "volume_targets"
  ],
  "additionalProperties": false,
  "title": "Fysigo Corrective Program (schemaVersion 1)"
}
